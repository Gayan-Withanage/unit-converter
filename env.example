# =============================================================================
# .env.example - Environment Variable Reference
# Unit Converter Web Application
# =============================================================================
# Copy this file to .env and customise values for your environment.
# The .env file is listed in .dockerignore and should NEVER be committed
# to version control, as it may contain sensitive information.
#
#   cp .env.example .env
# =============================================================================

# Port on the HOST machine that the application will be accessible on.
# Default: 8080  →  Access via http://localhost:8080
HOST_PORT=8080

# Node environment — affects how the application behaves.
# Options: development | production
NODE_ENV=production

# Application version — injected as a container label for tracking deployments.
APP_VERSION=1.0.0
